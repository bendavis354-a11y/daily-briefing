{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["metadata", "stats", "accounts", "sections"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generatedAt", "date", "timezone", "lastSuccessfulBuildAt", "dataFreshThrough"],
      "properties": {
        "generatedAt": { "type": "string" },
        "date": { "type": "string" },
        "timezone": { "type": "string" },
        "lastSuccessfulBuildAt": { "type": "string" },
        "dataFreshThrough": { "type": "string" },
        "liveUrl": { "type": "string" },
        "todayLabel": { "type": "string" },
        "tomorrowLabel": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": true,
      "required": ["emailsScanned", "urgent", "eventsTomorrow", "proposedEvents", "suggestedReplies", "todos"],
      "properties": {
        "emailsScanned": { "type": "number" },
        "urgent": { "type": "number" },
        "eventsTomorrow": { "type": "number" },
        "proposedEvents": { "type": "number" },
        "suggestedReplies": { "type": "number" },
        "todos": { "type": "number" }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["email", "label"],
        "properties": {
          "email": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "calendarId": { "type": "string" }
        }
      }
    },
    "calendars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "urgent": { "type": "array" },
        "tomorrowSchedule": { "type": "array" },
        "calendarProposals": { "type": "array" },
        "suggestedReplies": { "type": "array" },
        "todos": { "type": "array" },
        "business": { "type": "array" },
        "personal": { "type": "array" },
        "financial": { "type": "array" },
        "waiting": { "type": "array" },
        "newsletter": { "type": "array" },
        "spam": { "type": "array" }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": true,
      "required": ["headline", "story", "arcs"],
      "properties": {
        "headline": { "type": "string", "maxLength": 160 },
        "story": { "type": "string" },
        "arcs": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "title", "today"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "account": { "type": "string" },
              "importance": { "type": "number" },
              "trend": { "type": "string", "enum": ["rising", "steady", "waiting", "stalling", "closing", "new"] },
              "stakes": { "type": "string" },
              "soFar": { "type": "string" },
              "today": { "type": "string" },
              "heading": { "type": "string" },
              "needs": { "type": "string" },
              "conversationKeys": { "type": "array", "items": { "type": "string" } },
              "viewThreadAccount": { "type": "string" },
              "viewThreadId": { "type": "string" },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["type", "label"],
                  "properties": {
                    "type": { "type": "string", "enum": ["reply", "open", "calendar"] },
                    "label": { "type": "string" },
                    "account": { "type": "string" },
                    "to": { "type": "string" },
                    "subject": { "type": "string" },
                    "body": { "type": "string" },
                    "threadId": { "type": "string" },
                    "title": { "type": "string" },
                    "start": { "type": "string" },
                    "end": { "type": "string" },
                    "location": { "type": "string" },
                    "details": { "type": "string" }
                  }
                }
              },
              "memory": { "type": "string" }
            }
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["question"],
            "properties": {
              "question": { "type": "string" },
              "context": { "type": "string" },
              "leaning": { "type": "string" },
              "arcId": { "type": "string" },
              "options": { "type": "array" }
            }
          }
        },
        "quickHits": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "account": { "type": "string" },
              "source": { "type": "string" },
              "viewThreadAccount": { "type": "string" },
              "viewThreadId": { "type": "string" }
            }
          }
        },
        "noise": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "count": { "type": "number" },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}
